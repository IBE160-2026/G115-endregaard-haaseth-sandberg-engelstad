# Copy to .env (which git ignores). Every variable is optional.
# The key stays on the server; the browser never sees it. Without it the app runs the scripted demo
# dialog, labelled «Demo – forhåndsskrevet dialog, ikke live AI».
ANTHROPIC_API_KEY=
# 1 = always run the demo dialog, even with a key.
DEMO=
# Which fixtures/<dialog> the demo plays (default garage).
DEMO_DIALOG=
# Where «Send til forhandler» POSTs the lead (ai-byggplant.lead/1). Empty = demo, nothing is sent.
LEAD_WEBHOOK_URL=
# Port for npm start (default 8080).
PORT=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "byggapp": {
      "root": "ByggAPP",
      "framework": "vite"
    },
    "ai_byggplant": {
      "root": "AI_BYGGplant",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/ai-byggplant/ npm run build -- --outDir dist/ai-byggplant",
      "outputDirectory": "dist"
    },
    "ai_byggplant_api": {
      "root": "AI_BYGGplant",
      "runtime": "node",
      "entrypoint": "server/vercel.ts",
      "functions": {
        "server/vercel.ts": {
          "includeFiles": "{brand.json,fixtures/**}",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/ai-byggplant/api/(.*)", "destination": { "service": "ai_byggplant_api" } },
    { "source": "/ai-byggplant", "destination": { "service": "ai_byggplant" } },
    { "source": "/ai-byggplant/(.*)", "destination": { "service": "ai_byggplant" } },
    { "source": "/(.*)", "destination": { "service": "byggapp" } }
  ]
}

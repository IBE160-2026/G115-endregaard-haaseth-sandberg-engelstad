{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai_byggplant": {
      "root": "AI_BYGGplant",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/ai-byggplant/ npm run build -- --outDir dist/ai-byggplant",
      "outputDirectory": "dist"
    },
    "ai_byggplant_api": {
      "root": "AI_BYGGplant",
      "runtime": "node",
      "entrypoint": "server/vercel.ts",
      "functions": {
        "server/vercel.ts": {
          "includeFiles": "{AI_BYGGplant/brand.json,AI_BYGGplant/fixtures/**,brand.json,fixtures/**}",
          "maxDuration": 60
        }
      }
    }
  },
  "redirects": [
    { "source": "/", "destination": "/ai-byggplant/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ai-byggplant/api/(.*)", "destination": { "service": "ai_byggplant_api" } },
    { "source": "/ai-byggplant", "destination": { "service": "ai_byggplant" } },
    { "source": "/ai-byggplant/(.*)", "destination": { "service": "ai_byggplant" } }
  ]
}
